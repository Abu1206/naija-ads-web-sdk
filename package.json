{
  "name": "naija-ads-web-sdk",
  "version": "0.3.0",
  "description": "Web SDK for Naija Ads: layout-safe banner, interstitial, rewarded and audio ads.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abu1206/naija-ads-web-sdk.git"
  },
  "homepage": "https://github.com/Abu1206/naija-ads-web-sdk#readme",
  "bugs": {
    "url": "https://github.com/Abu1206/naija-ads-web-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.global.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "^26.1.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0"
}
